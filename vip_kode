    # ------------------------------------------------------------------------
    # LSPB streaming function (uændret fra din kode)
    # ------------------------------------------------------------------------
    def execute_lspb_trajectory(via_points, segment_durations, max_accel,
                                dt=TRAJ_STREAM_DT, log_csv_path=None):
        via = np.asarray(via_points, dtype=float)
        n_joints = via.shape[1]
        assert n_joints == 6, "Expected 6-joint trajectory"

        if np.isscalar(max_accel):
            max_accels = [float(max_accel)] * n_joints
        else:
            max_accels = list(max_accel)

        joint_trajs = []
        t_array = None
        for j in range(n_joints):
            t_arr, theta, _, _, _ = lspb_via_points(
                via[:, j], segment_durations, max_accels[j], dt=dt
            )
            joint_trajs.append(theta)
            if t_array is None:
                t_array = t_arr

        n_samples = len(t_array)
        print(f"  → Streaming {n_samples} samples over {t_array[-1]:.2f} s "
              f"({1/dt:.0f} Hz)")

        piper.MotionCtrl_2(0x01, 0x01, TRAJ_STREAM_SPEED, 0x00)

        collected_rows = []

        loop_start = time.time()
        for i in range(n_samples):
            j0 = round(joint_trajs[0][i] * factorRadToDeg)
            j1 = round(joint_trajs[1][i] * factorRadToDeg)
            j2 = round(joint_trajs[2][i] * factorRadToDeg)
            j3 = round(joint_trajs[3][i] * factorRadToDeg)
            j4 = round(joint_trajs[4][i] * factorRadToDeg)
            j5 = round(joint_trajs[5][i] * factorRadToDeg)
            piper.JointCtrl(j0, j1, j2, j3, j4, j5)

            tcp = piper.GetArmEndPoseMsgs().end_pose
            collected_rows.append([
                i,
                round(float(t_array[i]), 4),
                round(joint_trajs[0][i], 6), round(joint_trajs[1][i], 6),
                round(joint_trajs[2][i], 6), round(joint_trajs[3][i], 6),
                round(joint_trajs[4][i], 6), round(joint_trajs[5][i], 6),
                round(tcp.X_axis  / factorMeterToMicro, 6),
                round(tcp.Y_axis  / factorMeterToMicro, 6),
                round(tcp.Z_axis  / factorMeterToMicro, 6),
                round(tcp.RX_axis / factorRadToDeg,     6),
                round(tcp.RY_axis / factorRadToDeg,     6),
                round(tcp.RZ_axis / factorRadToDeg,     6),
            ])

            next_target = loop_start + t_array[i] + dt
            sleep_time = next_target - time.time()
            if sleep_time > 0:
                time.sleep(sleep_time)

        # pos_end nået — gem al indsamlet data til CSV
        if log_csv_path is not None:
            with open(log_csv_path, mode="w", newline="") as csv_file:
                csv_writer = csv.writer(csv_file)
                csv_writer.writerow([
                    "sample", "time_s",
                    "q1_cmd_rad", "q2_cmd_rad", "q3_cmd_rad",
                    "q4_cmd_rad", "q5_cmd_rad", "q6_cmd_rad",
                    "x_m", "y_m", "z_m",
                    "rx_rad", "ry_rad", "rz_rad",
                ])
                csv_writer.writerows(collected_rows)
            print(f"  → Positions saved to {log_csv_path}")

        elapsed = time.time() - loop_start
        print(f"  → Trajectory complete in {elapsed:.2f} s")

    # ------------------------------------------------------------------------
    # Via-point CSV export: FK on each via point → position + orientation
    # ------------------------------------------------------------------------
    def save_via_points_csv(via_points_array, csv_path):
