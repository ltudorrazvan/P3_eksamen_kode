                writer.writerow([
                    i,
                    round(q[0], 6), round(q[1], 6), round(q[2], 6),
                    round(q[3], 6), round(q[4], 6), round(q[5], 6),
                    round(pos[0], 6), round(pos[1], 6), round(pos[2], 6),
                    round(rpy[0], 6), round(rpy[1], 6), round(rpy[2], 6),
                    round(quat[0], 6), round(quat[1], 6),
                    round(quat[2], 6), round(quat[3], 6),
                ])
        print(f"  → Via-point poses saved to {csv_path}")

