# ============================================================================
# === DH-PARAMETRE & IK (fra piper_ik_final_v2.py) ===========================
# ============================================================================
d1 = 0.123
a3 = 0.28503
a4 = -0.02198
d4 = 0.25075
d6 = 0.111

theta2_offset = -172.22 * np.pi / 180
theta3_offset = -102.78 * np.pi / 180

PIPER_LIMITS = [
    (-2.687, 2.687),
    (0.0,    3.403),
    (-3.054, 0.0),
    (-1.850, 1.850),
    (-1.309, 1.309),
    (-1.745, 1.745),
]


def wrap(angle):
    return (angle + np.pi) % (2 * np.pi) - np.pi


def dh_transform(alpha, a, d, theta):
    ca, sa = np.cos(alpha), np.sin(alpha)
    ct, st = np.cos(theta), np.sin(theta)
    return np.array([
        [ct,     -st,     0,    a    ],
        [st*ca,  ct*ca,  -sa,  -sa*d ],
        [st*sa,  ct*sa,   ca,   ca*d ],
        [0,      0,       0,    1    ],
    ])


def forward_kinematics(thetas):
    t1, t2, t3, t4, t5, t6 = thetas
    T01 = dh_transform(0,        0,    d1, t1)
    T12 = dh_transform(-np.pi/2, 0,    0,  t2 + theta2_offset)
    T23 = dh_transform(0,        a3,   0,  t3 + theta3_offset)
    T34 = dh_transform(np.pi/2,  a4,   d4, t4)
    T45 = dh_transform(-np.pi/2, 0,    0,  t5)
    T56 = dh_transform(np.pi/2,  0,    d6, t6)
    return T01 @ T12 @ T23 @ T34 @ T45 @ T56


def compute_T03(t1, t2, t3):
    T01 = dh_transform(0,        0,  d1, t1)
    T12 = dh_transform(-np.pi/2, 0,  0,  t2 + theta2_offset)
    T23 = dh_transform(0,        a3, 0,  t3 + theta3_offset)
    return T01 @ T12 @ T23


def compute_T01(t1):
    return dh_transform(0, 0, d1, t1)


def inverse_kinematics(p_d, R_d):
    p_d = np.asarray(p_d, dtype=float)
    R_d = np.asarray(R_d, dtype=float)
    p_w = p_d - d6 * R_d[:, 2]
    solutions = []
    t1_a = np.arctan2(p_w[1], p_w[0])
    for theta1 in (t1_a, t1_a + np.pi):
        T01 = compute_T01(theta1)
        p_w_f1 = np.linalg.inv(T01) @ np.append(p_w, 1.0)
        x1, y1, z1 = p_w_f1[:3]
        if abs(y1) > 1e-6:
            continue
        A = x1
        B = -z1
        C = (x1**2 + z1**2 + a3**2 - a4**2 - d4**2) / (2 * a3)
        norm_AB = np.hypot(A, B)
        if norm_AB < 1e-12 or abs(C / norm_AB) > 1:
            continue
        phi_ab = np.arctan2(B, A)
        base = np.arccos(np.clip(C / norm_AB, -1, 1))
        for sign_u in (+1, -1):
            u = phi_ab + sign_u * base
            M = np.array([[d4, a4], [-a4, d4]])
            rhs = np.array([x1 - a3*np.cos(u), z1 + a3*np.sin(u)])
            sinS, cosS = np.linalg.solve(M, rhs)
            S = np.arctan2(sinS, cosS)
            v = wrap(S - u)
            theta2 = u - theta2_offset
            theta3 = wrap(v - theta3_offset)
            T03 = compute_T03(theta1, theta2, theta3)
            R03 = T03[:3, :3]
            R36 = R03.T @ R_d
            cos_t5 = -R36[1, 2]
            sin_sq = R36[0, 2]**2 + R36[2, 2]**2
            if sin_sq < 1e-12:
                theta5 = 0.0 if cos_t5 > 0 else np.pi
                theta4 = 0.0
                theta6 = np.arctan2(-R36[0, 1], R36[0, 0])
                solutions.append((wrap(theta1), theta2, theta3,
                                  wrap(theta4), wrap(theta5), wrap(theta6)))
                continue
            for sign_s5 in (+1, -1):
                sin_t5 = sign_s5 * np.sqrt(sin_sq)
                theta5 = np.arctan2(sin_t5, cos_t5)
                theta4 = np.arctan2(R36[2, 2] / sin_t5, R36[0, 2] / sin_t5)
                theta6 = np.arctan2(-R36[1, 1] / sin_t5, R36[1, 0] / sin_t5)
                solutions.append((wrap(theta1), theta2, theta3,
                                  wrap(theta4), wrap(theta5), wrap(theta6)))
    return solutions


def verify_and_filter(solutions, p_d, R_d, tol=1e-4):
    good = []
    for sol in solutions:
        T = forward_kinematics(sol)
        p_err = np.linalg.norm(T[:3, 3] - p_d)
        R_err = np.linalg.norm(T[:3, :3] - R_d)
        if p_err < tol and R_err < tol:
            good.append((sol, p_err, R_err))
    return good


# ============================================================================
# === LSPB FUNCTION ==========================================================
# ============================================================================

def lspb_via_points(via, segment_durations, max_accel, dt=0.01):
    """LSPB trajectory through a sequence of joint angles for ONE joint."""
    via = np.asarray(via, dtype=float)
    td = np.asarray(segment_durations, dtype=float)
    n = len(via)
    assert len(td) == n - 1, "Need n-1 segment durations for n via points"

    v = np.zeros(n - 1)
    t_b = np.zeros(n)
    a_signed = np.zeros(n)

    if abs(via[1] - via[0]) < 1e-12:
        t_b[0] = 0.0; a_signed[0] = 0.0; v[0] = 0.0
    else:
        a_signed[0] = np.sign(via[1] - via[0]) * max_accel
        disc = td[0]**2 - 2 * (via[1] - via[0]) / a_signed[0]
        if disc < 0:
            raise ValueError("Infeasible at first via")
        t_b[0] = td[0] - np.sqrt(disc)
        v[0] = (via[1] - via[0]) / (td[0] - 0.5 * t_b[0])

    if abs(via[-1] - via[-2]) < 1e-12:
        t_b[-1] = 0.0; a_signed[-1] = 0.0; v[-1] = 0.0
    else:
        a_signed[-1] = np.sign(via[-2] - via[-1]) * max_accel
        disc = td[-1]**2 + 2 * (via[-1] - via[-2]) / a_signed[-1]
        if disc < 0:
            raise ValueError("Infeasible at last via")
        t_b[-1] = td[-1] - np.sqrt(disc)
        v[-1] = (via[-1] - via[-2]) / (td[-1] - 0.5 * t_b[-1])

    for k in range(1, n - 1):
        v_in = v[0] if k == 1 else (via[k] - via[k - 1]) / td[k - 1]
        v_out = v[-1] if k == n - 2 else (via[k + 1] - via[k]) / td[k]
        v[k - 1] = v_in
        v[k] = v_out
        if abs(v_out - v_in) < 1e-12:
            t_b[k] = 0.0; a_signed[k] = 0.0
        else:
            a_signed[k] = np.sign(v_out - v_in) * max_accel
            t_b[k] = (v_out - v_in) / a_signed[k]

    t_lin = np.zeros(n - 1)
    t_lin[0] = td[0] - t_b[0] - 0.5 * t_b[1]
    t_lin[-1] = td[-1] - t_b[-1] - 0.5 * t_b[-2]
    for j in range(1, n - 2):
        t_lin[j] = td[j] - 0.5 * t_b[j] - 0.5 * t_b[j + 1]
    if any(t_lin < -1e-9):
        raise ValueError("Blend zones overlap")

    T_total = float(np.sum(td))
    t = np.arange(0, T_total + dt, dt)
    theta = np.zeros_like(t)
    theta_dot = np.zeros_like(t)
    theta_ddot = np.zeros_like(t)
    via_times = np.concatenate(([0.0], np.cumsum(td)))
    blend_start = via_times - t_b / 2
    blend_end = via_times + t_b / 2
    blend_start[0] = 0.0
    blend_end[-1] = T_total

    for i, ti in enumerate(t):
        in_blend = False
        for k in range(n):
            if blend_start[k] <= ti <= blend_end[k]:
                in_blend = True
                tau = ti - blend_start[k]
                v_in = 0.0 if k == 0 else v[k - 1]
                if k == 0:
                    theta_at_start = via[0]
                else:
                    theta_at_start = (via[k] - v_in * t_b[k] / 2
                                      - 0.5 * a_signed[k] * (t_b[k] / 2)**2)
                theta[i] = theta_at_start + v_in * tau + 0.5 * a_signed[k] * tau**2
                theta_dot[i] = v_in + a_signed[k] * tau
                theta_ddot[i] = a_signed[k]
                break
        if not in_blend:
            for k in range(n - 1):
                if blend_end[k] < ti < blend_start[k + 1]:
                    tau = ti - blend_end[k]
                    if k == 0:
                        theta_at_blend_end = via[0] + 0.5 * a_signed[0] * t_b[0]**2
                    else:
                        v_in = v[k - 1]
                        theta_at_blend_end = (via[k] + v_in * t_b[k] / 2
                                              + 0.5 * a_signed[k] * (t_b[k] / 2)**2)
                    theta[i] = theta_at_blend_end + v[k] * tau
                    theta_dot[i] = v[k]
                    theta_ddot[i] = 0.0
                    break

    return t, theta, theta_dot, theta_ddot, t_b


# ============================================================================
# === HJÆLPEFUNKTIONER TIL VIPPE-BEVÆGELSE ===================================
# ============================================================================

def build_tilt_via_points(start_joints, end_joints, n_via_points=20):
    """
    Bygger en liste af via-points i ledrum, hvor TCP-positionen holdes
    konstant gennem hele bevægelsen og kun orienteringen ændres.
    
    Input:  start_joints og end_joints (lister med 6 led-vinkler i radianer)
    Output: numpy-array med shape (n_via_points, 6) klar til LSPB
    
    Trinene er:
    1. Beregn start- og slut-pose med FK
    2. For hvert ønsket via-point, lav SLERP mellem rotationerne
    3. Hold positionen konstant
    4. Brug IK til at finde de led-vinkler der opnår den ønskede pose
    5. Vælg løsningen tættest på den forrige (for kontinuitet)
    """
    
    # 1. FK på start og slut for at finde poses
    T_start = forward_kinematics(start_joints)
    T_end = forward_kinematics(end_joints)
    
    p_target = T_start[:3, 3]            # TCP-position skal være KONSTANT
    R_start = T_start[:3, :3]
    R_end = T_end[:3, :3]
    
    # 2. Tjek at start og slut faktisk har samme TCP-position
    p_diff = np.linalg.norm(T_end[:3, 3] - p_target)
    if p_diff > 0.005:
        print(f"  ADVARSEL: start og slut har {p_diff*1000:.1f}mm positionsforskel")
        print(f"           Bevægelsen bliver ikke en ren vippe.")
    
    print(f"  Konstant TCP-position: {p_target.round(4)} m")
    print(f"  Bygger {n_via_points} via-points...")
    
    # 3. SLERP-objekt til orienterings-interpolation
    rotations = Rotation.from_matrix(np.stack([R_start, R_end]))
    slerp_obj = Slerp([0, 1], rotations)
    
    # 4. Liste til de udregnede via-points
    via_joints = []
    current_joints = np.array(start_joints)
    
    # 5. For hvert via-point: SLERP → IK → vælg løsning
    s_values = np.linspace(0, 1, n_via_points)
    
    for i, s in enumerate(s_values):
        # Den ønskede orientering for dette via-point
        R_now = slerp_obj([s]).as_matrix()[0]
        
        # IK for konstant position, varierende orientering
        raw_sols = inverse_kinematics(p_target, R_now)
        good = verify_and_filter(raw_sols, p_target, R_now)
        
        # Filtrér løsninger der overtræder ledgrænserne
        LIMIT_TOL = 0.05  # 0.05 rad tolerance for numeriske unøjagtigheder nær grænser
        valid = [sol for sol, _, _ in good
                 if all(lo - LIMIT_TOL <= q <= hi + LIMIT_TOL
                        for q, (lo, hi) in zip(sol, PIPER_LIMITS))]

        if not valid and good:
            # Ingen løsning inden for tolerance — brug den med mindst grænseovertrædelse
            def limit_violation(sol):
                return sum(max(0.0, lo - q, q - hi)
                           for q, (lo, hi) in zip(sol, PIPER_LIMITS))
            best_sol, best_pe, best_re = min(good, key=lambda x: limit_violation(x[0]))
            viol = limit_violation(best_sol)
            if viol > 0.15:
                raise RuntimeError(
                    f"Ingen gyldig IK-løsning ved s={s:.3f} (via-point {i}), "
                    f"mindste grænseovertrædelse = {viol:.4f} rad"
                )
            print(f"  ADVARSEL via-point {i}: bedste løsning har {viol:.4f} rad grænseovertrædelse")
            valid = [best_sol]

        if not valid:
            raise RuntimeError(
                f"Ingen gyldig IK-løsning ved s={s:.3f} (via-point {i})"
            )
        
        # Vælg løsningen tættest på forrige (kontinuitet)
        chosen = min(valid, key=lambda q: np.linalg.norm(
            wrap(np.array(q) - current_joints)
        ))
        
        via_joints.append(list(chosen))
        current_joints = np.array(chosen)
    
    print(f"  Færdig - alle {n_via_points} via-points udregnet")
    return np.array(via_joints)


